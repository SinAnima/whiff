Notebook[{
Cell["Saltmere tides", "Title"],
Cell["High water", "Section"],
Cell["The bell rings at high tide.", "Text"],
Cell[BoxData[RowBox[{"tide", "[", "t_", "]", ":=", RowBox[{"2", " ", RowBox[{"Sin", "[", "t", "]"}]}]}]], "Input"],
Cell[BoxData["2"], "Output"]
}]
