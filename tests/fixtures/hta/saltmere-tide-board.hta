<html>
<head>
<title>Saltmere tide board</title>
<HTA:APPLICATION ID="tideBoard" APPLICATIONNAME="Saltmere Tide Board" VERSION="1.0"
  BORDER="thin" SINGLEINSTANCE="yes" WINDOWSTATE="normal" SHOWINTASKBAR="yes"/>
